# ---------------------------------------------------------
# Code Generation (build_runner, injectable, riverpod, hive)
# ---------------------------------------------------------
# Note: Most teams COMMIT generated files (*.g.dart, *.config.dart) so teammates
# can run the project without running build_runner immediately.
# If you prefer to ignore generated files and run build_runner on CI/CD, uncomment below:
*.g.dart
*.config.dart
*.freezed.dart

